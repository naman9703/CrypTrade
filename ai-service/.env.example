AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8001

# Where to store model + feedback data (relative to ai-service/)
MODEL_DIR=./data/model
FEEDBACK_CSV=./data/feedback/trades.csv

# Default label horizon (minutes) for offline training/backtests
LABEL_HORIZON_MIN=10

# Learning loop improvements
FEEDBACK_HALF_LIFE_DAYS=14
FEEDBACK_REQUIRE_NONZERO_PNL=1

# XGBoost requires an OpenMP runtime. macOS: brew install libomp. Linux (Debian/Ubuntu): sudo apt install libgomp1
# Silence startup hint when you intentionally run without XGBoost:
# AI_SILENCE_XGBOOST_HINT=1
# Skip pre-flight check in `npm run dev:ai` (HistGradientBoosting-only dev):
# SKIP_XGBOOST_VERIFY=1

# Binance /train/from-binance — production-oriented generalization (defaults are tuned for live-ish use)
# Emphasize recent candles (half-life in days); set 0 for uniform weights
TRAIN_RECENCY_HALF_LIFE_DAYS=30
# Bootstrap rows per ensemble member (0 = off, 0.85–0.92 improves diversity; default 0.88)
TRAIN_ENSEMBLE_BAG_FRACTION=0.88

# Predict: blend isotonic vs Platt logistic calibration (1 = isotonic only, 0 = Platt only)
AI_CAL_BLEND_ISOTONIC=0.72

