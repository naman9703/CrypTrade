{
  "name": "ai-crypto-trading-platform",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "db:up": "docker compose -f docker-compose.db.yml up -d",
    "db:migrate": "npm --workspace backend run db:migrate",
    "db:setup": "npm --workspace backend run db:migrate:local",
    "dev": "npx --no-install npm-run-all -p dev:ai dev:backend dev:frontend",
    "dev:no-ai": "npx --no-install npm-run-all -p dev:backend dev:frontend",
    "dev:backend": "npm --workspace backend run dev",
    "dev:frontend": "npm --workspace frontend run dev",
    "dev:ai": "bash ai-service/scripts/run-dev-ai.sh",
    "build": "npx --no-install npm-run-all -s build:backend build:frontend",
    "build:backend": "npm --workspace backend run build",
    "build:frontend": "npm --workspace frontend run build"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}

