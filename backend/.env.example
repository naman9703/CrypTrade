# Backend server
PORT=8000

# Phase 1A — PostgreSQL + TimescaleDB (optional until features use the DB)
# Local: from repo root → docker compose -f docker-compose.db.yml up -d
# Then: npm run db:migrate (backend) or npm run db:setup (starts compose + waits + migrates).
# DATABASE_URL=postgres://postgres:tradingdev@127.0.0.1:54333/trading
# If the DB user cannot CREATE ROLE: SKIP_DB_ROLES=1 npm run db:migrate
#
# Phase 1C — encrypt `api_credentials.secret_enc` (AES-256-GCM). Required before POST /api/accounts/:id/credentials.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# API_CREDENTIALS_ENCRYPTION_KEY=

# Phase 1B — app connection (pool + optional PG sessions + /api/trading-modes)
# When DATABASE_URL is set, the server connects at startup (fails fast if unreachable).
# Sessions persist in table express_sessions (migration 015). Run: npm run db:migrate after pulling.
# DB login: users.username holds normalized email; seed once: ADMIN_EMAIL=... ADMIN_PASSWORD='...' npm run db:seed-admin
# Env bcrypt users (APP_UI_AUTH_EMAIL + hash) still work if no row exists in DB for that email.
# Optional split vars instead of DATABASE_URL: DB_HOST, DB_PORT, DB_NAME, DB_USER, DB_PASSWORD, DB_SSL=true
#
# Backtests read `ohlcv_candles` (Binance OHLC). When the DB pool is active, finalized Binance kline closes
# from the running server are upserted into that table (set BACKTEST_ARCHIVE_LIVE_OHLCV=0 to disable).
#
# WebSocket keepalive interval (ms) for reverse proxies / NAT. Default 30000. Set 0 to disable (not recommended in production).
# WS_PING_INTERVAL_MS=30000
FRONTEND_ORIGIN=http://localhost:5173
# Production + docker-compose: set to the exact public URL (https://...) users open. Compose also sets AI_BASE_URL to the `ai` service — override only if needed:
# AI_BASE_URL=http://ai:8001
# NODE_ENV=production
# SERVE_FRONTEND=1

# Optional UI gate: single shared login before /api/* and /ws (bcrypt hash, not plaintext password).
# Generate hash: cd backend && npm install && node scripts/hash-ui-password.mjs   (or APP_UI_PASSWORD=... BCRYPT_ROUNDS=12 node scripts/hash-ui-password.mjs)
# Production: set SESSION_SECRET to a long random string (>=32 chars). Secure session cookie: when NODE_ENV=production and COOKIE_SECURE is unset, first FRONTEND_ORIGIN drives it (http:// → insecure cookie for local http; https:// or empty → secure). Override with COOKIE_SECURE=0/1.
# Behind nginx/Caddy: set TRUST_PROXY=1 so rate limits and secure cookies see the real client IP / TLS.
# Production hardening: refuse to start if UI login is off (recommended for any public host):
# REQUIRE_APP_UI_AUTH_IN_PRODUCTION=1
# HTTP rate limits (trust-proxy-aware IP): /api except /api/auth/* and /api/backtest/* (backtest panel polls heavily); defaults 2000 req / 15 min per IP.
# API_RATE_LIMIT_MAX=2000
# API_RATE_LIMIT_WINDOW_MS=900000
# Disable API + login HTTP rate limits (local dev only; unsafe on the public internet):
# API_RATE_LIMIT_DISABLED=1
# or: API_RATE_LIMIT_MAX=0
LOGIN_HTTP_RATE_LIMIT_DISABLED=1
# or: LOGIN_HTTP_RATE_LIMIT_MAX=0
# Stricter cap on POST /api/auth/login only (per IP): LOGIN_HTTP_RATE_LIMIT_MAX=60
# APP_UI_AUTH_ENABLED=1
# One user via env, or multiple via numbered env pairs (_1 .. _20) — merged (same email: legacy APP_UI_AUTH_EMAIL wins last):
# APP_UI_AUTH_EMAIL=you@example.com
# APP_UI_AUTH_PASSWORD_HASH=$2b$12$...   # bcrypt output from hash-ui-password.mjs
# Docker: `docker-compose.yml` bind-mounts this file into the app container; use normal bcrypt (`$2b$12$...`).
# Do not list the same secrets in the project root `.env` — Compose interpolates that file and breaks `$` in hashes.
# APP_UI_AUTH_EMAIL_1=other@example.com
# APP_UI_AUTH_PASSWORD_HASH_1=$2b$12$...
# SESSION_SECRET=replace-with-random-32-plus-chars
# TRUST_PROXY=1
# COOKIE_SECURE=1
# Session cookie lifetime (ms). Default is 24h if unset. Longer e.g. 7d: APP_UI_AUTH_SESSION_MS=604800000
# APP_UI_AUTH_SESSION_MS=86400000
# Split-origin SPA (UI on another host than API): FRONTEND_ORIGIN must list the UI origin; fetch uses credentials. For cross-site cookies you may need sameSite:none + Secure (change in auth/uiGate.js) or serve the SPA from the API host.
#
# Bot runs on the server: closing the browser or signing out of the UI does NOT stop it (only restart, safety stops, mode switch, or POST /api/bot/stop).
# Start the bot automatically on every process start (e.g. after VPS reboot):
# BOT_START_ON_BOOT=1
# When UI auth is on, optional long random key (16+ chars) for headless API only — header X-Bot-Api-Key on GET /api/state, POST /api/bot/start, POST /api/bot/stop:
# BOT_HTTP_API_KEY=
#
# Telegram sidecar (optional): push Activity (engine on/off, indicator signal lines) + trade OPEN/CLOSE; poll for /status /bot_on /bot_off.
# Uses a background queue so trading never awaits Telegram. Create bot via @BotFather.
# You must open the bot in Telegram and tap "Start" once, or sends will fail (Forbidden: bot can't initiate...).
# TELEGRAM_CHAT_ID = your numeric user id (or group id); use @userinfobot or send /status and check server log "telegram_chat_rejected" → fromChatId.
# If you ever set a webhook on this bot, long polling breaks until webhook is removed — backend now calls deleteWebhook on start.
# TELEGRAM_STARTUP_PING=1 — optional one message on boot to verify outbound delivery.
# TELEGRAM_ENABLED=1
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=123456789

# AI service (FastAPI)
AI_BASE_URL=http://localhost:8001
# /predict and /feedback can exceed 10s on cold start or large candle payloads (default 60s)
AI_PREDICT_TIMEOUT_MS=60000
# Minimum candles before calling AI /predict (must match FastAPI min_items, default 30)
# AI_PREDICT_MIN_CANDLES=30
# Health and other short AI calls (default 15s)
AI_HTTP_TIMEOUT_MS=15000

# ── Market intelligence (optional; collectors no-op without keys) ─────────────────
# Optional: encrypt Finnhub / CQ / Whale Alert / AI base URL from UI (⚙ on Market Intelligence) — reuse API_CREDENTIALS_ENCRYPTION_KEY.

# CryptoQuant bearer token → CQ exchange netflow (USD ≈ native × Binance spot) merged into OnChain card (BTCUSDT/ETHUSDT).
# CRYPTOQUANT_API_KEY=
# CRYPTOQUANT_EXCHANGE_ENTITY=all_exchange

# Finnhub → economic calendar rows in `market_events` + crypto headline sentiment via AI `/news_impact_score`.
# FINNHUB_API_KEY=

# Liquidations (4h): Binance USD-M futures `!forceOrder@arr` WebSocket — no API key (override URL if needed).
# BINANCE_FUTURES_LIQUIDATIONS_WS_URL=wss://fstream.binance.com/ws/!forceOrder@arr

# Whale Alert → `whale_alerts` table + optional WS `whale_alert` for high-impact rows.
# WHALE_ALERT_API_KEY=
# WHALE_ALERT_MIN_VALUE_USD=5000000
# WHALE_ALERT_WS_IMPACT_MIN=70

# Cold-start auto-train (no compatible model): data volume and label params (see ai-service TRAIN_* for model fitting)
# AUTO_TRAIN_CANDLES_PER_SYMBOL=24000
# AUTO_TRAIN_HORIZON=90
# AUTO_TRAIN_FEE_BPS=10

# Market data feed: SYNTH (default), BINANCE (ambiguous spot vs USD-M — see bot `effectiveMarketFeedKind`), or BINANCE_FUTURES (USDT-M public).
# Live on cloud: spot is often 451-blocked while fapi/fstream still works — prefer BINANCE_FUTURES for USD-M charts.
# With MARKET_FEED=BINANCE, AUTO + both Supertrend toggles off now defaults **strict** modes (live/demo/testnet) to USD-M OHLCV.
MARKET_FEED=BINANCE_FUTURES
BINANCE_WS_BASE=wss://stream.binance.com:9443/ws
# Supertrend bar-close execution uses Binance **WebSocket** klines (`symbol@kline_<tf>` / combined stream), not REST polling.
# `k.x === true` on each message is what triggers `onCandleClose` → `processSupertrendCandleClose` (see marketFeedBinance*.js).
# Combined kline multiplex (AUTO multi Supertrend): max streams per connection, debounced resubscribe (ms), reconnect bounds.
# BINANCE_COMBINED_MAX_STREAMS=12
# BINANCE_COMBINED_RESUBSCRIBE_MS=400
# BINANCE_WS_RECONNECT_MIN_MS=1500
# BINANCE_WS_RECONNECT_MAX_MS=60000
# USD-M WebSocket (see developers.binance.com USD-M market streams): handshake timeout; optional client `ping()` keepalive (server sends ping ~3m).
# If `BINANCE_FUTURES_WS_BASE` / `BINANCE_COMBINED_BASE` point at **spot** hosts, the feed coerces to `fstream.binance.com` (live) or `fstream.binancefuture.com` (demo/testnet).
# BINANCE_WS_OPEN_TIMEOUT_MS=30000
# BINANCE_WS_CLIENT_PING_MS=120000
# Multiplex primary `symbol@aggTrade` on the same WebSocket as klines (spot + USD-M; **live mainnet and demo/testnet** use the same code path). Default on; set 0 for a separate trades socket (debug / legacy).
# BINANCE_AGGTRADE_MULTIPLEX=1
# UI chart live watch: when the frontend requests `/api/market/candles?symbol=XYZ`, the backend temporarily
# subscribes XYZ into the combined kline stream so OHLCV stays real-time without REST lag.
# UI_CHART_WATCH_TTL_MS=600000
# UI_CHART_WATCH_MAX=6
# Spot combined-stream base (default stream.binance.com:9443/stream); futures: BINANCE_FUTURES_COMBINED_BASE=wss://fstream.binance.com/stream
# BINANCE_COMBINED_BASE=wss://stream.binance.com:9443/stream
# BINANCE_FUTURES_COMBINED_BASE=wss://fstream.binance.com/stream
# BINANCE_FUTURES_REST_BASE=https://fapi.binance.com
# BINANCE_FUTURES_WS_BASE=wss://fstream.binance.com/ws
# Docker/Railway: if MARKET_FEED=BINANCE or BINANCE_FUTURES and the matching ping is not 200 (e.g. 451), entrypoint sets SYNTH unless disabled.
# BINANCE_SYNTH_FALLBACK=0

# PAPER mode only: which **public** Binance venue drives OHLCV / WebSocket klines / depth / universe REST (orders still use local paper ledgers).
# Unset: if MARKET_FEED is BINANCE or BINANCE_FUTURES, paper inherits it; otherwise paper defaults to BINANCE_FUTURES except when Market mode is SPOT (UI) → BINANCE.
# Set to SYNTH for legacy fully synthetic candles (Supertrend bar-close autotrade will not match live venue).
# PAPER_MARKET_FEED=BINANCE_FUTURES

# Bot decision loop + full WS `market` snapshot cadence (indicators, Supertrend line, etc.). Default 1000.
# Live **candle** OHLC also streams on each Binance kline (throttled by MARKET_LIVE_CANDLE_MS) so the chart updates faster than BOT_TICK_MS.
# BOT_TICK_MS=1000
# Min gap between live candle pushes per kline burst (ms). Default 100; lower = smoother chart, more WS traffic.
# MARKET_LIVE_CANDLE_MS=100

# Futures autotrade trailing (Supertrend-based)
# Open/close fee rates are fractions (0.0004 = 0.04%). Round-trip = open + close.
# TRADE_OPEN_FEE_RATE=0.0004
# TRADE_CLOSE_FEE_RATE=0.0004
#
# Safety multiplier on round-trip fee for the T02 lock (= entry + mult × round-trip-fee).
# Default 1.0: T02 lock = entry + round-trip fee → gross = fees, net ≈ 0 (break-even per spec).
# Raise (e.g. 1.25) only if you want T02 gross > fees to cover stop-market slippage.
# FUTURES_TRAIL_FEE_BE_MULT=1.0
#
# Tiered T01 lock offset from entry. Default 0 → T01 lock = entry (zero-loss point; gross=0, net=-fees).
# Set a small positive value (e.g. 0.0002 = 2 bp) only to clear sub-tick noise.
# Must be < FUTURES_TRAIL_FEE_BE_MULT × round-trip fee; otherwise T01 lock ≥ T02 lock and T02 never fires.
# FUTURES_TRAIL_T01_LOCK_SLIPPAGE_FRAC=0
#
# Activation buffer past breakeven before trailing engages — T01 and T02 tiers ONLY
# (fraction; default 0.0015 = 0.15% — HTF_RSI sweep sweet spot with advanced-only trailing).
# Activation buffer before Supertrend trail engages (fraction of price).
# HTF_RSI max return: match fixed TP (e.g. 0.025 = 2.5%). Fewer SL: 0.0015.
# SUPERTREND_TRAIL_BUFFER_RATE=0.025
#
# Independent activation buffer for post-T02 profit rungs (T1, T2, T3…). Fraction of price.
# Unset / empty = inherit SUPERTREND_TRAIL_BUFFER_RATE (legacy single-buffer behaviour). Any
# non-negative value decouples the profit-rung pull-back cushion from the fee-recovery cushion,
# e.g. keep T01/T02 tight for fast loss protection while giving T1+ a larger noise cushion.
# FUTURES_TRAIL_POST_T02_ACTIVATION_BUFFER_RATE=0.0014
# TRAIL_POST_T02_SPACING_FRAC=0.002
#
# Minimum fractional distance between mark and new SL to avoid noise (default 0.002 = 0.2%).
# SUPERTREND_TRAIL_MIN_SL_DISTANCE_FRAC=0.002
#
# Liquidation-vs-breakeven guard parameter (default 0.005 = 0.5%).
# SUPERTREND_TRAIL_MAINTENANCE_MARGIN_RATE=0.005

# Fixed-USDT capital: after (allowed margin pool − open initial margin), keep this percent as strategy “usable” headroom (default 90).
# USABLE_CAPITAL_BUFFER_PCT=90

# Trading mode: PAPER (default), BINANCE_TESTNET (spot + futures testnet hybrid),
# BINANCE_DEMO_API (demo spot + demo-fapi or local futures sim), or BINANCE_LIVE (mainnet — real money; requires BINANCE_LIVE_TRADING_ENABLED=1).
TRADING_MODE=BINANCE_TESTNET

# Paper persistence (CSV + JSON snapshot). PAPER mode uses hybrid **spot + USD-M sim**; headline equity is the sum of both ledgers.
PAPER_STORE_DIR=./data/paper
# Paper futures sim (optional override; default is mode-scoped `.../paper/paper-futures/`)
# PAPER_FUTURES_STORE_DIR=./data/paper-futures

# Per-mode UI state: activity log, trade-ws-events.jsonl (portfolio history), supertrend-signal-history.jsonl
# (chart signal list), bot-trading-config under data/modes/<slug>/ (paper | demo_api | testnet | live)
# unless legacy paths below are set.
# Optional: raise how many trades merge into WS hello (default = TRADE_WS_LOG_MAX_LINES).
# Trade WS JSONL + merged snapshot cap (raise if OPEN/CLOSE rows disappear from history UI).
# TRADE_HISTORY_SNAPSHOT_MAX=4000
# SUPERTREND_SIGNAL_HISTORY_STATE_MAX=2000
# SUPERTREND_SIGNAL_HISTORY_MAX_LINES=8000
# MODE_DATA_ROOT=data/modes

# Trading / bot UI settings — if set, use this single file for all modes (overrides per-mode layout).
# BOT_TRADING_CONFIG_PATH=data/bot-trading-config.json

# Activity logs — if set, use this file for all modes (overrides per-mode layout).
# ACTIVITY_LOG_PATH=data/activity-log.jsonl
# ACTIVITY_LOG_MAX_LINES=8000

# Trade WS payloads — if set, use this file for all modes (overrides per-mode layout).
# TRADE_WS_LOG_PATH=data/trade-ws-events.jsonl
# TRADE_WS_LOG_MAX_LINES=4000

# Binance Spot Demo Mode (real demo orders via API)
# Docs: https://developers.binance.com/docs/binance-spot-api-docs/demo-mode/general-info
BINANCE_DEMO_REST_BASE=https://demo-api.binance.com/api
BINANCE_DEMO_WS_BASE=wss://demo-stream.binance.com/ws
BINANCE_DEMO_API_KEY=
BINANCE_DEMO_API_SECRET=
BINANCE_DEMO_ALLOW_AUTO=0
# Minimum USDT notional for spot MARKET buys (Supertrend and demo spot orders skip below this). Binance is typically ~5 USDT.
# BINANCE_SPOT_MIN_QUOTE_USDT=5.5
# Keep this fraction of free quote unspent on MARKET BUY so `quoteOrderQty` stays below wallet (-2010 slack + fees). Default 0.002 (0.2%).
# BINANCE_SPOT_QUOTE_RESERVE_PCT=0.002
# Min seconds between repeated “free USDT below minimum” Activity warns (default 10m).
# SUPERTREND_LOW_USDT_WARN_COOLDOWN_MS=600000
# Indicator spot “full wallet”: fraction of free USDT to spend on BUY (1 = ~100%; use 0.998–0.999 if the exchange rejects full balance).
# SUPERTREND_SPOT_NOTIONAL_BUFFER_PCT=1
# Supertrend futures BUY sizing uses RISK_PER_TRADE + AI confidence (not full-margin buffer). With riskPerTradeUnit USDT, RISK_PER_TRADE is target notional per trade.
# Min USDT notional for Supertrend futures BUY (exchange floor is often ~5).
# SUPERTREND_FUTURES_MIN_NOTIONAL_USDT=5
# Optional floor on gated AI probability before Supertrend futures BUY (0 = disabled).
# SUPERTREND_FUTURES_MIN_AI_PROB=0.55
# Futures risk tiers use max(AI gate, chart signal strength) for position sizing when 1 (default). Set 0 to size only from AI.
# SUPERTREND_FUTURES_BLEND_ST_SIGNAL=1
# When UI turns off the Supertrend futures AI confidence filter, floor sizing confidence at least this (0.35–0.95). Default 0.55.
# SUPERTREND_FUTURES_NO_AI_FILTER_SIZING_FLOOR=0.55
# When /predict has no score yet, Supertrend futures BUY uses this probability for risk sizing (default in code 0.58 if unset). Set 0 to hard-require AI.
# SUPERTREND_FUTURES_AI_FALLBACK_PROB=0.58
# Supertrend USD-M entry: skip if wall-clock delay after **scheduled bar close** exceeds this (ms). 0 = disabled. Bar close time ≈ candle open ts + timeframe (e.g. 1m bar opens :21, closes :22). Adds latency from AI /predict + REST.
# SUPERTREND_FUTURES_MAX_SIGNAL_LAG_MS=0
# Max entry slippage vs **signal candle close**: best bid/ask, mark (premium index), and book mid vs close. Percent points, e.g. 0.15 = 0.15%. 0 = disable caps (and disables auto LIMIT_IOC default). Default in code 0.15 when unset.
# SUPERTREND_FUTURES_MAX_ENTRY_SLIPPAGE_PCT=0.15
# Opening order: MARKET or LIMIT_IOC. When **unset**, defaults to LIMIT_IOC if slippage % > 0, else MARKET. LIMIT_IOC uses limit = close × (1±pct), timeInForce IOC.
# SUPERTREND_FUTURES_OPEN_STYLE=
# After first book/mark check, wait this many ms and re-check (0 = off). Catches fast drift before send.
# SUPERTREND_FUTURES_ENTRY_RECHECK_MS=0
# If 1, after LIMIT_IOC returns no fill, re-quote book/mark; if still within slippage cap, retry as MARKET. Default off (missed trade safer than chasing).
# SUPERTREND_FUTURES_IOC_FALLBACK_MARKET=0
# If 1, skip entry when mark price (premium index) cannot be fetched while slippage guard is active.
# SUPERTREND_FUTURES_REQUIRE_MARK_PRICE=0
# If 1, skip entry when bookTicker fetch fails while slippage guard is active.
# SUPERTREND_FUTURES_REQUIRE_BOOK_TICKER=0
# When true (default), bar-close only trades/logs Activity when the chart would show a marker (same sanitize + forming-bar rule as the UI). Set false for legacy raw-flip behavior.
# SUPERTREND_STRICT_CHART_ALIGN=true
# Composite signal strength: minimum score (0–100) for WAIT tier; below this is SKIP. TRADE tier is fixed at ≥65 in code. Default 40.
# SIGNAL_STRENGTH_MIN_WAIT=40
# Min composite strength (0–100) for Supertrend opens when signalStrengthGatesTrades is on (UI/bot state; default 65).
# SIGNAL_STRENGTH_OPEN_MIN=65
# Move quality defaults (also set via UI / botConfig): min score, ADX, move/SL ratio, ATR mult (1.0 = raw ATR% vs SL), ATR expansion, body vs avg.
# Optional: directional body 0–1 (0=off), volume vs avg ratio (0=off, e.g. 1.2).
# SUPERTREND_MOVE_QUALITY_MIN_SCORE=0.6
# SUPERTREND_MOVE_QUALITY_MIN_ADX=23
# SUPERTREND_MOVE_QUALITY_MIN_MOVE_SL_RATIO=1.5
# SUPERTREND_MOVE_QUALITY_ATR_EXPECT_MULT=1.0
# SUPERTREND_MOVE_QUALITY_MIN_ATR_EXPANSION=1.08
# SUPERTREND_MOVE_QUALITY_MIN_BODY_VS_AVG=0.62
# SUPERTREND_MOVE_QUALITY_MIN_DIRECTIONAL_BODY=0
# SUPERTREND_MOVE_QUALITY_MIN_VOLUME_VS_AVG=0
# Primary chart: defer entry until close breaks signal high/low (1/true/yes to enable).
# SUPERTREND_BREAKOUT_CONFIRM=0
# SUPERTREND_BREAKOUT_MAX_BARS=5
# Append Supertrend close + mqAtEntry rows to data/modes/<slug>/mq-trade-outcomes.jsonl for scripts/analyze-mq-trades.mjs (set 0 to disable).
# MQ_TRADE_OUTCOMES_LOG=1
# Feed staleness gate: min threshold (ms) before “Feed: stale” can trigger; default 25000. Also FEED_STALE_MAX_MS, FEED_STALE_MS (fixed override).
# FEED_STALE_MIN_MS=25000
# Bot auto-stop if neither kline nor aggTrade WS has received a message for this long (ms). Default 60000. Increase on flaky networks (e.g. 120000).
# FEED_STALE_MS=60000
# After a feed-stale auto-stop, restart the bot automatically when the feed is healthy again (default 1). Set 0 to disable.
# FEED_AUTO_RESTART=1

# Binance USD-M Futures Demo Mode (real demo futures via API)
# Base endpoint: https://demo-fapi.binance.com
# If keys below are empty, backend will reuse BINANCE_DEMO_API_KEY/SECRET.
BINANCE_DEMO_FUTURES_REST_BASE=https://demo-fapi.binance.com
# Public USD-M streams for demo-fapi default to Binance’s testnet stream host (pairs with demo-fapi per General Info).
# To force mainnet marks/klines while trading on demo-fapi (not recommended — prices won’t match the testnet book):
# BINANCE_DEMO_FUTURES_WS_BASE=wss://fstream.binance.com/ws
# BINANCE_DEMO_FUTURES_COMBINED_BASE=wss://fstream.binance.com/stream
# BINANCE_FUTURES_TESTNET_WS_BASE=wss://fstream.binancefuture.com/ws
# BINANCE_FUTURES_TESTNET_COMBINED_BASE=wss://fstream.binancefuture.com/stream
BINANCE_DEMO_FUTURES_API_KEY=
BINANCE_DEMO_FUTURES_API_SECRET=
# Signed REST (spot + USD-M): max recvWindow (ms, cap 60000) and how often to sync local clock to Binance serverTime — cuts -1021 timestamp skew.
# BINANCE_RECV_WINDOW_MS=60000
# BINANCE_TIME_SYNC_INTERVAL_MS=120000
# Futures demo: match fapi income REALIZED_PNL to a recent manual/local close (ms). Default 300000 (5m).
# BINANCE_DEMO_INCOME_MATCH_TTL_MS=300000
# Merge multiple income rows for the same exit into one CLOSE within this window (ms). Default 60000.
# BINANCE_DEMO_INCOME_MERGE_MS=60000

# Binance LIVE (mainnet — BINANCE_LIVE mode). Spot + USD-M futures hybrid; same behavior as demo API but real accounts.
# Set to 1 only after you understand risk. Use keys without withdrawal permission; IP whitelist recommended.
BINANCE_LIVE_TRADING_ENABLED=1
BINANCE_LIVE_REST_BASE=https://api.binance.com/api
BINANCE_LIVE_WS_BASE=wss://stream.binance.com:9443/ws
BINANCE_LIVE_API_KEY=
BINANCE_LIVE_API_SECRET=
BINANCE_LIVE_ALLOW_AUTO=0
BINANCE_LIVE_FUTURES_REST_BASE=https://fapi.binance.com
# Optional separate futures keys; else BINANCE_LIVE_API_KEY / SECRET are used.
BINANCE_LIVE_FUTURES_API_KEY=
BINANCE_LIVE_FUTURES_API_SECRET=
BINANCE_LIVE_FUTURES_INCOME_SYNC_PATH=data/binance-live-futures-income-sync.json
# Set to 1 only if you want unmatched REALIZED_PNL income rows in Portfolio / WS history (lifetime noise). Default 0 = strategy-first like demo.
# When 0, persisted trade-ws-events.jsonl ledger rows are also excluded from merges for LIVE/TESTNET (they used to reappear after restarts).
# BINANCE_LIVE_INCOME_INCLUDE_UNMATCHED=0
# BINANCE_LIVE_FUT_INCOME_BOOT_LOOKBACK_MS=600000
# BINANCE_LIVE_INCOME_MATCH_TTL_MS=300000
# BINANCE_LIVE_INCOME_PRE_CLOSE_SKEW_MS=120000
# Optional: look back this many ms in /fapi/v1/userTrades when synthesizing a missing OPEN leg for income CLOSE rows (default 30d).
# BINANCE_USDM_SYNTH_OPEN_LOOKBACK_MS=2592000000
# USD-M User Data Stream (default on): push account/position updates; REST /fapi/v2/account still seeds + reconciles.
# BINANCE_USDM_USER_DATA_STREAM=0
# Max age (ms) of last ACCOUNT_UPDATE before falling back to REST (default 8000).
# BINANCE_USDM_USER_STREAM_FRESH_MS=8000
# WebSocket base for private user stream (append /listenKey). Live default wss://fstream.binance.com/ws
# BINANCE_LIVE_FUTURES_USER_WS_BASE=wss://fstream.binance.com/ws
# Demo-fapi listen keys must use Binance’s demo/testnet stream host (not mainnet fstream).
# Default: wss://fstream.binancefuture.com/ws — override only if Binance documents a change.
# BINANCE_DEMO_FUTURES_USER_WS_BASE=wss://fstream.binancefuture.com/ws
# Futures testnet user stream (default wss://stream.binancefuture.com/ws)
# BINANCE_FUTURES_TESTNET_USER_WS_BASE=wss://stream.binancefuture.com/ws
# Spot: use outboundAccountPosition from user stream for getAccount() when fresh (default 5000 ms).
# BINANCE_SPOT_USER_STREAM_BALANCE_TTL_MS=5000

# Paper execution realism
PAPER_FEE_BPS=10
PAPER_SLIPPAGE_BPS=8

# Binance (used for testnet/live connectors) — use your own keys; never commit real secrets
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_REST_BASE=https://api.binance.com

# Binance Spot Testnet (recommended first)
BINANCE_TESTNET_REST_BASE=https://testnet.binance.vision
BINANCE_TESTNET_WS_BASE=wss://testnet.binance.vision/ws
# Comma-separated REST bases to try for POST /api/v3/userDataStream (testnet often returns 410; app retries + falls back to OCO polling)
BINANCE_TESTNET_USERDATA_REST_BASES=https://testnet.binance.vision
BINANCE_TESTNET_UDF_RETRY_MS=15000

# Binance USD-M Futures Testnet (connector scaffold)
BINANCE_FUTURES_TESTNET_REST_BASE=https://testnet.binancefuture.com
BINANCE_FUTURES_API_KEY=
BINANCE_FUTURES_API_SECRET=

# Persist testnet sync state (positions/trades)
BINANCE_TESTNET_STORE_DIR=./data/binance-testnet

# Execution safety limits (apply to BINANCE_TESTNET)
MAX_ORDER_NOTIONAL_USDT=50
MAX_OPEN_ORDERS=3

# Bot defaults
DEFAULT_SYMBOL=BTCUSDT
DEFAULT_TIMEFRAME=1m
AI_THRESHOLD=0.65
# When 1/true, use raw model score only for gating (ignores blend below).
AI_GATE_USE_RAW=0
# Weight on calibrated score when blending with raw (0..1). Default 0.65 = 35% raw — reduces isotonic collapse.
AI_GATE_CALIBRATED_BLEND=0.65
# When 1/true, backend gate uses only AI service output (no second cal/raw blend). Pair with AI service calibration only.
AI_GATE_CALIBRATED_ONLY=0
# Default risk/trade when bot loads (UI + POST /api/bot/config can override). Unit is set by riskPerTradeUnit: PCT = fraction of balance at stop; USDT = per-trade target notional (investing capital).
# When both riskPerTradeUnit and maxDailyLossUnit are USDT: that notional is 100% of riskPerTrade (no AI sizing tiers), strategy AI entry threshold is skipped, Supertrend futures min-AI gate off; SL/TP use ATR only.
RISK_PER_TRADE=0.01
MAX_DAILY_LOSS=0.05

# Coin selection (requires MARKET_FEED=BINANCE or BINANCE_FUTURES; set symbolMode AUTO via UI or POST /api/bot/config)
# Periodic Binance scan + auto primary rotation (UI Scan now / Auto coin pick). Off by default; set 1 to re-enable.
# UNIVERSE_SCAN_ENABLED=0
UNIVERSE_SIZE=30
UNIVERSE_TOP_KLINES=12
UNIVERSE_MIN_QUOTE_VOL=5000000
UNIVERSE_MAX_SPREAD_PCT=0.0015
# Max absolute correlation allowed between selected coins (based on recent log returns)
UNIVERSE_MAX_CORR=0.85
# Exclude stable/fiat-quoted majors (USDCUSDT, FDUSDUSDT, …). Set 0 to disable.
UNIVERSE_EXCLUDE_STABLES=1
# Extra symbols to drop from the scanner (comma-separated)
UNIVERSE_EXCLUDE_SYMBOLS=

# Modeled per-close fee on USDT quote notional when commission breakdown is missing (4 bps). Spot round-trip also uses this for entry/exit if fills omit commission.
# TRADE_CLOSE_FEE_RATE=0.0004         # Taker fee for SL exit (default 0.04%). Used to compute trailing T0 breakeven.
# TRADE_OPEN_FEE_RATE=0.0004          # Taker/maker fee for opening position (defaults to TRADE_CLOSE_FEE_RATE if unset).
#                                     # Round-trip fee = openFeeRate + closeFeeRate (e.g. 0.04%+0.04% = 0.08%).

# Risk guards / anti-overtrading
UNIVERSE_SWITCH_COOLDOWN_MS=300000
# AUTO symbol mode + no pinned coin: evaluate Supertrend on universe watchlist via REST klines (30s scan loop).
# Opens multiple positions across symbols; slot size = AUTO_MULTI_SLOT_PCT * (1−slot)^k * free quote (k = distinct open count).
# AUTO_MULTI_UNPINNED_SUPERTREND=0
# AUTO_MULTI_SLOT_PCT=0.3
# AUTO_MULTI_MAX_OPEN_POSITIONS=4
# AUTO_MULTI_WATCH_SIZE=15
# AUTO_MULTI_KLINES_LIMIT=450
TRADE_COOLDOWN_MS=60000
MAX_TRADES_PER_HOUR=6
MAX_CONCURRENT_POSITIONS=1
FEED_GRACE_MS_AFTER_SWITCH=12000

# Microstructure & funding guards (0 = disabled). Requires MARKET_FEED=BINANCE or BINANCE_FUTURES for depth.
# TRADE_MAX_SPREAD_BPS=12
# TRADE_MIN_DEPTH_NOTIONAL_USD=50000
# TRADE_DEPTH_LEVELS=5
# Block futures trades when |lastFundingRate| exceeds this (e.g. 0.0005 = 0.05% per 8h)
# FUNDING_BLOCK_ABS_RATE=0.0005
# FUNDING_CACHE_TTL_MS=60000
# FUNDING_FETCH_TIMEOUT_MS=5000

# RL bandit: decay past rewards each close (0.99 = emphasize recent outcomes; 1 = off)
# RL_BANDIT_REWARD_DECAY=1

# Strategy stability
REGIME_CONFIRM_CANDLES=4

# Regime-adaptive AI threshold (1=enabled, 0=use fixed AI_THRESHOLD everywhere)
AI_REGIME_ADAPTIVE=1

# Time-based exit: close positions older than this (ms). 0 = disabled.
# e.g. 3600000 = 1 hour, matching typical labeling horizon
MAX_POSITION_AGE_MS=0

# Drawdown safety: auto-stop bot if rolling drawdown exceeds this fraction of peak equity
MAX_DRAWDOWN_PCT=0.15

# Correlation guard: block trades on correlated assets when holding a position (0 = disabled, 1 = enabled)
PORTFOLIO_MAX_CORRELATION=1

# AI confidence tiers (in riskPlan; shown here for clarity)
# <0.65: skip, 0.65–0.7: small, 0.7–0.8: normal, 0.8+: slightly higher (capped by MAX_ORDER_NOTIONAL_USDT on testnet)

# Auto-retrain AI model from feedback every N closed trades (0 disables)
RETRAIN_EVERY_CLOSED_TRADES=20
RETRAIN_MIN_ROWS=200

# Coinalyze aggregated futures data (liquidations, OI) — research abstention
# Get key: https://coinalyze.net → Account → API Key
# COINALYZE_API_KEY=

