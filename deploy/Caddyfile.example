# Copy to /etc/caddy/Caddyfile (or include snippet) and replace the host name.
# Assumes the stack listens on 127.0.0.1:8000 (see docker-compose ports).
#
# Your public URL must match backend FRONTEND_ORIGIN and cookie SameSite expectations.
#
# WebSockets (/ws): Caddy's reverse_proxy passes Upgrade correctly by default — no extra
# headers needed (contrast nginx: deploy/nginx-site.example).

your.duckdns.org {
	encode zstd gzip
	# flush_interval -1: avoid buffering edge cases on long-lived / streaming responses (WS upgrade is handled automatically).
	reverse_proxy 127.0.0.1:8000 {
		flush_interval -1
	}
}
